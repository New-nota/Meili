DATABASE_URL=UR_URL
REDIS_URL=redis://redis:6379
VALHALLA_URL=http://valhalla:8002
# Где Valhalla строит маршруты: JSON-список [south, west, north, east].
# N городов = N прямоугольников; пусто/не задано = весь мир (планетные тайлы
# или внешний API). Для локального compose задаётся в docker-compose.yml.
# ROUTING_COVERAGE=[[54.30,19.60,55.35,23.05]]
SECRET_KEY=change-me-generate-your-own
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15

# --- Email (S7) — не задано => письма пишутся в лог (dev-режим)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM=noreply@wanderown.app

# --- Google OAuth2 (S7) — не задано => /auth/google/* отвечают 501
# Redirect URI в Google Console: http://localhost:8000/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# FRONTEND_URL=http://localhost:5173
# --- Cloudflare R2 (S9) — не задано => аватары отвечают 501
# R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# R2_BUCKET=wanderown
# R2_ACCESS_KEY=
# R2_SECRET_KEY=
# R2_PUBLIC_BASE_URL=https://cdn.example.com

# --- AI-ассистент Meili (ТЗ-Meili) — не задано => чат отвечает 501
# Провайдер: mistral (дефолт, ЕС-хостинг/GDPR) | deepseek (запасной).
# Модели пинятся в services/llm/{mistral,deepseek}.py; LLM_MODEL_* — override.
# LLM_API_KEY=
# LLM_PROVIDER=mistral
# LLM_MODEL_LOOP=
# LLM_MODEL_SUMMARY=
# Запасные модели через запятую (пусто — цепочка провайдера: ministral-14b, 8b).
# Клиент сам уходит на следующую, если модель недоступна тарифу/региону
# (403 tier_not_allowed, 429 с лимитом 0 в минуту, 404).
# LLM_MODEL_FALLBACKS=
# Доступ к провайдеру через другой регион (например, свой сервер в Казахстане):
#   вариант 1 — SSH-туннель:  ssh -N -D 1080 user@kz-server
#               LLM_HTTP_PROXY=socks5://host.docker.internal:1080
#   вариант 2 — обратный прокси на сервере (nginx location /mistral/ ->
#               https://api.mistral.ai/): LLM_BASE_URL=https://kz-server/mistral/v1
# LLM_HTTP_PROXY=
# LLM_BASE_URL=
# LLM_MAX_STEPS=8
# LLM_STEP_TIMEOUT_S=60
# MEILI_WINDOW_TOKENS=2000
