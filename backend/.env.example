DATABASE_URL=UR_URL
REDIS_URL=redis://redis:6379
VALHALLA_URL=http://valhalla:8002
SECRET_KEY=change-me-generate-your-own
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15

# --- Email (S7) — не задано => письма пишутся в лог (dev-режим)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM=noreply@wanderown.app

# --- Google OAuth2 (S7) — не задано => /auth/google/* отвечают 501
# Redirect URI в Google Console: http://localhost:8000/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# FRONTEND_URL=http://localhost:5173
# --- Cloudflare R2 (S9) — не задано => аватары отвечают 501
# R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# R2_BUCKET=wanderown
# R2_ACCESS_KEY=
# R2_SECRET_KEY=
# R2_PUBLIC_BASE_URL=https://cdn.example.com

# --- AI-ассистент Meili (ТЗ-Meili) — не задано => чат отвечает 501
# Провайдер: mistral (дефолт, ЕС-хостинг/GDPR) | deepseek (запасной).
# Модели пинятся в services/llm/{mistral,deepseek}.py; LLM_MODEL_* — override.
# LLM_API_KEY=
# LLM_PROVIDER=mistral
# LLM_MODEL_LOOP=
# LLM_MODEL_SUMMARY=
# LLM_MAX_STEPS=5
# LLM_STEP_TIMEOUT_S=30
# MEILI_WINDOW_TOKENS=2000
