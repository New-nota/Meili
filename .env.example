# Hermod — единый .env на весь проект (раньше было три: корень, backend/, frontend/).
#   cp .env.example .env   и впиши свои значения в ПУСТЫЕ строки.
#
# Кто читает:
#   docker compose — подставляет ${…} (Postgres, pgAdmin) и отдаёт файл целиком
#                    backend/worker (env_file);
#   backend        — pydantic Settings (лишние ключи игнорирует, «KEY=» = не задано);
#   frontend       — Vite (envDir = корень), в браузер попадают ТОЛЬКО VITE_*.
#
# Заполнено всё, что одинаково у всех. Пустые строки — личные секреты/токены:
# без них соответствующая фича просто выключена (отвечает 501), кроме
# SECRET_KEY — без него бэкенд не стартует.
#
# DATABASE_URL / REDIS_URL / VALHALLA_URL / ROUTING_COVERAGE здесь нет: адреса
# сервисов и зону карт собирает docker-compose.yml (зона = тайлы Valhalla,
# источник правды — scripts/valhalla_regions.txt).

# --- Postgres (локальный, в docker) -------------------------------------------
POSTGRES_USER=wanderown
POSTGRES_PASSWORD=wanderown
POSTGRES_DB=wanderown_db

# --- pgAdmin: docker compose --profile tools up -d pgadmin → http://localhost:5050
PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=admin

# --- Безопасность ---------------------------------------------------------------
# ОБЯЗАТЕЛЬНО и у каждого своё (подпись JWT):  openssl rand -hex 32
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
# за HTTPS на деплое — true; локально по http кука с Secure не ставится
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# откуда фронт (CORS + редирект после Google OAuth)
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=INFO
DB_ECHO=false

# --- Почта: пустой SMTP_HOST — письма (код регистрации) пишутся в лог backend ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@meili.app

# --- Google OAuth: пусто — «Войти через Google» отвечает 501 -------------------
# Redirect URI в Google Console: http://localhost:8000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Cloudflare R2 (аватары): пусто — загрузка аватара отвечает 501 -----------
# R2_ENDPOINT вида https://<account>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_PUBLIC_BASE_URL=

# --- Ассистент Meili: пустой LLM_API_KEY — чат отвечает 501 --------------------
LLM_API_KEY=
# mistral (дефолт, ЕС-хостинг) | deepseek (запасной)
LLM_PROVIDER=mistral
# пусто — модели, закреплённые в services/llm/{mistral,deepseek}.py
LLM_MODEL_LOOP=
LLM_MODEL_SUMMARY=
# запасные модели через запятую; пусто — цепочка провайдера, none — без запасных
LLM_MODEL_FALLBACKS=
# доступ к провайдеру через другой регион: LLM_BASE_URL — обратный прокси
# (https://kz-server/mistral/v1), LLM_HTTP_PROXY — socks5/http-прокси
# (ssh -N -D 1080 user@kz-server → socks5://host.docker.internal:1080)
LLM_BASE_URL=
LLM_HTTP_PROXY=
LLM_MAX_STEPS=8
LLM_STEP_TIMEOUT_S=60
MEILI_WINDOW_TOKENS=2000

# --- Геокодер бэкенда (город для Meili): публичный Nominatim, кэш в Redis -------
NOMINATIM_URL=https://nominatim.openstreetmap.org

# Этап B: 2ГИС — цены и рейтинг мест (ключ: platform.2gis.ru / dev.2gis.ru).
# Пусто — обогащение выключено. Проба ключа: python -m scripts.dgis_probe
DGIS_API_KEY=
DGIS_DAILY_LIMIT=1000

# --- Фронтенд (Vite) ------------------------------------------------------------
VITE_API_URL=http://localhost:8000
